# Committed PHPStan config.
#
# phpstan.neon (no .dist) is gitignored and, if present, overrides this
# file entirely — keep personal tweaks there. This .dist is what CI uses.

includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 7
    # PHPStan 2 proves a condition dead when PHPDoc says it cannot happen.
    # In WordPress plugin code PHPDoc is aspirational: values arrive from
    # get_field(), HTTP responses, scraped HTML and $_POST, none of which the
    # annotation can guarantee. Trusting it would mean deleting defensive
    # guards that are correct at runtime, so PHPDoc informs types but does not
    # prove conditions. Native types are still checked normally.
    treatPhpDocTypesAsCertain: false
    # An ignoreErrors pattern that stops matching is reported as an error by
    # default, so a stale pattern would fail the gate — and whether a pattern
    # matches depends on which sibling plugins are present, which differs
    # between a developer's checkout and CI. Matches amber.
    reportUnmatchedIgnoredErrors: false
    paths:
        - src
    excludePaths:
        - tests
    bootstrapFiles:
        - vendor/autoload.php
    # Sentinel is an optional runtime dependency: HasLogger degrades to
    # error_log() when it is absent. Scanning its source makes
    # Sentinel_Log_Channel resolvable without requiring it via composer.
    # sentinel-logger.php is not PSR-4 compliant and composer skips it when
    # generating autoload rules, so scanDirectories (which reads files
    # directly) is what resolves it. Matches amber and trumpet.
    scanDirectories:
        # Tamar is a Beacon driver and implements its contracts.
        - ../beacon/src
        - ../sentinel/src
    scanFiles:
        # Defines TAMAR_OPTION_KEY and the other plugin constants. Not under
        # paths (which is src only), so it has to be scanned explicitly.
        - tamar.php
    ignoreErrors:
        # WordPress functions that PHPStan doesn't recognize
        - '#Function get_plugin_data not found#'
        - '#Function dbDelta not found#'
        # A wp-config.php salt. Defined by the site, never by the plugin.
        - '#Constant AUTH_KEY not found#'
